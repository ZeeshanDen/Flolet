# Copy to .env.local and fill with your Firebase web app config.
# Until you provide these, the app runs against the local Firebase Emulator Suite in dev.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to force the app to use the local emulator even in prod builds.
VITE_USE_EMULATOR=
