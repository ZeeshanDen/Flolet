rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Require a verified email for ALL access — UI gating alone is bypassable.
    // Google sign-in is verified by default; password users must confirm the link.
    function signedIn() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Personal data: user owns everything under their uid ----
    match /users/{uid} {
      allow read, write: if isSelf(uid);

      match /{sub=**} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---- Groups: only members can read; membership gates writes ----
    match /groups/{groupId} {
      function isMember() {
        return signedIn() &&
          request.auth.uid in resource.data.memberUids;
      }

      // Deterministic invite id (groupId_email) lets rules verify a real,
      // pending invite exists for the joining user without a query.
      function hasPendingInvite() {
        return get(/databases/$(database)/documents/invites/$(groupId + '_' + request.auth.token.email)).data.status == 'pending';
      }

      // Joining via invite may ONLY add the caller: memberUids grows by
      // exactly their uid and the members map gains only their key.
      function isSelfJoin() {
        return signedIn() &&
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'members']) &&
          request.resource.data.memberUids.toSet() ==
            resource.data.memberUids.toSet().union([request.auth.uid].toSet()) &&
          request.resource.data.members.diff(resource.data.members)
            .affectedKeys().hasOnly([request.auth.uid]) &&
          hasPendingInvite();
      }

      // Creator starts alone; must include self and nobody else.
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberUids == [request.auth.uid] &&
        request.resource.data.members.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100;

      allow read: if isMember();

      // Members may edit group fields but never reassign ownership or
      // grow membership; non-members may only self-join with an invite.
      allow update: if (
          isMember() &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.memberUids.toSet()
            .difference(resource.data.memberUids.toSet()).size() == 0
        ) || isSelfJoin();

      // Only the creator can delete the group.
      allow delete: if signedIn() &&
        resource.data.createdBy == request.auth.uid;

      match /expenses/{expId} {
        function parentMember() {
          return signedIn() &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        }
        function validExpense() {
          return request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount < 100000000;
        }
        allow read, delete: if parentMember();
        allow create, update: if parentMember() && validExpense();
      }

      match /settlements/{sId} {
        function parentMember() {
          return signedIn() &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        }
        function validSettlement() {
          return request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.amount < 100000000;
        }
        allow read, delete: if parentMember();
        allow create, update: if parentMember() && validSettlement();
      }
    }

    // ---- Invites: doc id is `groupId_email` (lowercased) ----
    match /invites/{inviteId} {
      // Only current group members may invite, invite starts pending,
      // and the doc id must match its contents so joins can be verified.
      allow create: if signedIn() &&
        request.resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        inviteId == request.resource.data.groupId + '_' +
          request.resource.data.invitedEmail &&
        request.auth.uid in
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids;

      allow read: if signedIn() && (
        request.auth.token.email == resource.data.invitedEmail ||
        request.auth.uid == resource.data.invitedByUid
      );

      // The invited user may accept/decline (status only); inviter may not
      // rewrite the target email or group after the fact.
      allow update: if signedIn() &&
        request.auth.token.email == resource.data.invitedEmail &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']);

      allow delete: if signedIn() &&
        request.auth.uid == resource.data.invitedByUid;
    }
  }
}
