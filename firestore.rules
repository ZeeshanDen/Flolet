rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Require a verified email for ALL access — UI gating alone is bypassable.
    // Google sign-in is verified by default; password users must confirm the link.
    function signedIn() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Personal data: user owns everything under their uid ----
    match /users/{uid} {
      allow read, write: if isSelf(uid);

      match /{sub=**} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---- Groups: only members can read; membership gates writes ----
    match /groups/{groupId} {
      function isMember() {
        return signedIn() &&
          request.auth.uid in resource.data.memberUids;
      }
      function willBeMember() {
        return signedIn() &&
          request.auth.uid in request.resource.data.memberUids;
      }

      // Creator must include self in memberUids.
      allow create: if willBeMember() &&
        request.resource.data.createdBy == request.auth.uid;
      allow read: if isMember();
      // Members may update (e.g. add a member on invite accept).
      allow update: if isMember() || willBeMember();
      allow delete: if isMember();

      match /expenses/{expId} {
        function parentMember() {
          return signedIn() &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        }
        allow read, create, update, delete: if parentMember();
      }

      match /settlements/{sId} {
        function parentMember() {
          return signedIn() &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        }
        allow read, create, update, delete: if parentMember();
      }
    }

    // ---- Invites: readable by the invited email or the inviter ----
    match /invites/{inviteId} {
      allow create: if signedIn() &&
        request.resource.data.invitedByUid == request.auth.uid;
      allow read, update: if signedIn() && (
        request.auth.token.email == resource.data.invitedEmail ||
        request.auth.uid == resource.data.invitedByUid
      );
      allow delete: if signedIn() &&
        request.auth.uid == resource.data.invitedByUid;
    }
  }
}
